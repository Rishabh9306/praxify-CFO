# Environment Configuration for Praxify CFO - AIML Engine
# Copy this file to .env and update the values as needed

# ==========================================
# GOOGLE GEMINI API
# ==========================================
GOOGLE_API_KEY=your_google_api_key_here

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================
# RECOMMENDED: Use JSON String method (more secure, no file in repo)
# Copy the entire service account JSON on one line

FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ALTERNATIVE: File Path (only if you need it for local dev, not recommended)
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_LOCAL_PATH=./firebase-service-account.json

# Application Environment
ENV=production  # Options: development, staging, production

# API Configuration
API_PORT=8000
LOG_LEVEL=info  # Options: debug, info, warning, error, critical

# Nginx Configuration (only used when starting with nginx profile)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Resource Limits (for docker-compose)
CPU_LIMIT=2
MEMORY_LIMIT=4G

# Optional: External Database Configuration (if needed in future)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: Cloud Storage Configuration (if needed)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# Optional: Monitoring and Logging (if needed)
# SENTRY_DSN=your_sentry_dsn
# LOG_FILE_PATH=/app/logs/app.log
